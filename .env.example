# ==============================================================================
# Anatomica Environment Configuration
# ==============================================================================

# Provider Selection ("opencode", "gemini", or "offline" for agents; "cloudflare" or "offline" for Arm 1)
LLM_PROVIDER=opencode
VLM_PROVIDER=gemini
IMAGE_PROVIDER=cloudflare

# 1. OpenCode Go (OpenAI-compatible — for Parser & Expander agents)
OPENCODE_API_KEY=your_opencode_go_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-chat
# Optional: set if your OpenCode Go tier exposes a vision-capable model for VLM_PROVIDER=opencode
OPENCODE_VISION_MODEL=

# 2. Google AI Studio Free Tier (No credit card required: https://aistudio.google.com/apikey)
# Recommended for VerifierAgent (VLM image inspection)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Cloudflare Workers AI Free Tier (10,000 Neurons/day free, no card required)
# Used for Arm 1 (Diffusion PNG) — supports @cf/black-forest-labs/flux-1-schnell or @cf/stabilityai/stable-diffusion-xl-base-1.0
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# 4. Arm 2 — Parametric 3D Asset Configuration (FLAME 2023 Open)
FLAME_MODEL_PATH=assets/flame/flame2023.pkl

# 5. Defaults
DEFAULT_SKIN_TONE=monk_4
MAX_EDIT_LOOPS=2
